# Random string, >=16 chars. Becomes part of the connector URL: https://your-domain/mcp/<MCP_SECRET>
MCP_SECRET=
# Full JSON of the Google service-account key (single line), or the same JSON base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: property used when a tool call omits siteUrl.
DEFAULT_SITE=sc-domain:thesurferweligama.com
PORT=3000
